# Linux systemd：将二进制放到 /usr/local/bin/dp2codex，密钥写入环境文件（chmod 600）
#
#   sudo install -m755 dp2codex /usr/local/bin/
#   sudo install -d /etc/dp2codex
#   printf 'DEEPSEEK_API_KEY=sk-...\nDP2CODEX_LISTEN=127.0.0.1:9090\n' | sudo tee /etc/dp2codex/env
#   sudo chmod 600 /etc/dp2codex/env
#   sudo install -m644 deploy/systemd/dp2codex.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dp2codex

[Unit]
Description=dp2codex DeepSeek proxy for Codex CLI
Documentation=https://github.com/your-org/dp2codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/dp2codex/env
ExecStart=/usr/local/bin/dp2codex
Restart=always
RestartSec=3
# 日志目录（可选）：默认 ~/.dp2codex/logs；此处改为全局目录便于运维
# Environment=DP2CODEX_LOG_DIR=/var/log/dp2codex
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
