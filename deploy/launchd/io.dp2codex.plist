<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd 后台常驻：
    cp deploy/launchd/io.dp2codex.plist ~/Library/LaunchAgents/
    # 编辑 plist 写入 DEEPSEEK_API_KEY，或使用 shell 注入 EnvironmentVariables
    launchctl load ~/Library/LaunchAgents/io.dp2codex.plist
    launchctl kickstart -k gui/$(id -u)/io.dp2codex
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.dp2codex</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/dp2codex</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DP2CODEX_LISTEN</key>
    <string>127.0.0.1:9090</string>
    <!-- <key>DEEPSEEK_API_KEY</key><string>sk-...</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dp2codex.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dp2codex.stderr.log</string>
</dict>
</plist>
